# Cloudflare Pages redirect rules. Order matters: the first match wins.
#
# Cloudflare Pages already serves /menu from menu.html and answers
# /menu.html with a 308 to /menu, so the clean-URL rewrites below are a
# safety net for hosts without that behaviour rather than the mechanism.

/home / 301

# retired pages -> the section that replaced them
/events        /services#events 301
/contact       /about#contact   301
/gallery       /about#gallery   301
/events.html   /services#events 301
/contact.html  /about#contact   301
/gallery.html  /about#gallery   301

# legacy .html URLs -> canonical clean URLs
/about.html             /about             301
/rooms.html             /rooms             301
/services.html          /services          301
/menu.html              /menu              301
/booking.html           /booking           301
/experiences.html       /experiences       301
/privacy-policy.html    /privacy-policy    301
/cookie-policy.html     /cookie-policy     301
/terms-of-service.html  /terms-of-service  301

# clean URLs -> the files that serve them
/                       /index.html              200
/about                  /about.html              200
/rooms                  /rooms.html              200
/services               /services.html           200
/menu                   /menu.html               200
/booking                /booking.html            200
/experiences            /experiences.html        200
/privacy-policy         /privacy-policy.html     200
/cookie-policy          /cookie-policy.html      200
/terms-of-service       /terms-of-service.html   200
/404                    /404.html                200

