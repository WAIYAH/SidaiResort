# Sidai Safari Dreams — Local Development Environment
# Copy this file to .env and adjust values

APP_ENV=
APP_DEBUG=
APP_URL=
WEB_ROOT=

# Database
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Session (disable secure cookie for HTTP localhost)
SESSION_COOKIE_SECURE=

# SMTP (leave empty to disable email sending)
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# M-Pesa (Sandbox credentials)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_ENVIRONMENT=
