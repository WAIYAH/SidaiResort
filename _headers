# Cloudflare Pages headers. This is the file the live host reads - the header
# blocks in netlify.toml were never applied. Verified against production on
# 5 Sep 2026: only x-content-type-options and referrer-policy were being sent.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), ambient-light-sensor=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self' https://wa.me; object-src 'none'; frame-ancestors 'self'; upgrade-insecure-requests; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://www.googletagmanager.com https://www.google-analytics.com https://www.googleadservices.com https://googleads.g.doubleclick.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; img-src 'self' data: blob: https:; media-src 'self' blob: https:; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://stats.g.doubleclick.net https://ad.doubleclick.net https://googleads.g.doubleclick.net https://www.google.com https://www.googleadservices.com https://cdn.jsdelivr.net; frame-src 'self' https://www.google.com https://td.doubleclick.net https://bid.g.doubleclick.net https://www.youtube.com https://player.vimeo.com

# Menu photography is content-addressed by dish slug and only ever replaced by
# a new filename, so it is safe to pin for a year. Cloudflare Polish/Images can
# re-encode these at the edge without the origin changing.
/assets/images/dining/menu/*
  Cache-Control: public, max-age=31536000, immutable

# Menu data is read at build time, but pin it too for anything fetching it live.
/data/*
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/json; charset=utf-8

# The menu card keeps its filename across updates, so it gets an hour rather
# than a year - a guest should not be handed last season's prices.
/assets/downloads/*
  Cache-Control: public, max-age=3600, must-revalidate

# Everything else under /assets keeps a day. These paths are not fingerprinted,
# so `immutable` here would strand visitors on a stale logo or stylesheet until
# the filename changes.
/assets/*
  Cache-Control: public, max-age=86400, must-revalidate
